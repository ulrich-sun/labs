# Copier en argocd-repo.yaml (ignoré par Git) et remplir.
# Inutile si le dépôt GitOps est PUBLIC. Même jeton que Kargo possible
# (Argo CD n'a besoin que de la lecture).
apiVersion: v1
kind: Secret
metadata:
  name: excalidraw-poc-repo
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
stringData:
  type: git
  url: __GITOPS_REPO__
  username: kargo
  password: __GIT_TOKEN__
