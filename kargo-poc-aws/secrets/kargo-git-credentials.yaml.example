# Copier en kargo-git-credentials.yaml (ignoré par Git) et remplir.
# Identifiants GitHub utilisés par Kargo (git-clone, git-push, git-open-pr).
# Jeton "fine-grained" : GitHub > Settings > Developer settings > Fine-grained tokens
#   - Repository access : uniquement le dépôt GitOps de la POC
#   - Permissions : Contents = Read and write ; Pull requests = Read and write
apiVersion: v1
kind: Secret
metadata:
  name: gitops-repo-creds
  namespace: excalidraw-poc
  labels:
    kargo.akuity.io/cred-type: git
stringData:
  repoURL: __GITOPS_REPO__
  username: kargo
  password: __GIT_TOKEN__
