# Copier en config.env, adapter, puis lancer ./configure.sh
# Toutes les valeurs sont obligatoires.

# Dépôt Git qui héberge ce dossier. Kargo y lit la branche main et écrit les
# branches stage/dev, stage/staging, stage/prod. HTTPS ou SSH :
#   https://github.com/mon-org/mon-depot.git   ou   git@github.com:mon-org/mon-depot.git
GITOPS_REPO="https://github.com/mon-org/mon-depot.git"

# Chemin de ce dossier dans le dépôt ("." s'il est à la racine du dépôt)
APP_PATH="kargo-poc-portable"

# Domaine dont tous les sous-domaines pointent vers ta Gateway (DNS wildcard).
# URLs obtenues : kargo.<APPS_DOMAIN>, workflows.<APPS_DOMAIN>,
#                 excalidraw-dev|staging|prod.<APPS_DOMAIN>
APPS_DOMAIN="apps.example.com"

# Gateway (Gateway API) existante, servie par Traefik :
#   kubectl get gateway -A
#   kubectl get gateway <nom> -n <ns> -o jsonpath='{.spec.listeners[*].name}'
GATEWAY_NAME="traefik-gateway"
GATEWAY_NAMESPACE="traefik"
GATEWAY_SECTION="web"            # nom du listener (HTTP ou HTTPS)

# Namespace où tourne Argo CD
ARGOCD_NAMESPACE="argocd"
